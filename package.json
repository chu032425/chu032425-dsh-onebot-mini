{
  "name": "dsh-onebot-mini",
  "version": "0.1.0",
  "description": "OneBot 11 (NapCat) channel for DeepSeek Harness: QQ messages reach a dsh agent and replies go back through the OneBot API, with a config page and a live WebSocket log page.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "PUSH.md",
    "index.js",
    "config.js",
    "logbus.js",
    "wire.js",
    "connection.js",
    "bridge.js",
    "message.js",
    "tools.js",
    "toolcatalog.js",
    "imagecache.js",
    "cachepaths.js",
    "media.js",
    "cacheinfo.js",
    "inbound.js",
    "prompt.js",
    "api.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "onebot",
    "onebot11",
    "qq",
    "napcat",
    "qq-bot",
    "channel"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node test/unit.test.mjs && node test/client.test.mjs && node test/runtime.test.mjs"
  }
}
